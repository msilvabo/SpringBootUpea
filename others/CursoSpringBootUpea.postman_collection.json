                "exec": [
                  "// 1. Obtener la respuesta en formato JSON\r",
                  "var jsonData = pm.response.json();\r",
                  "\r",
                  "// 2. Extraer el token (Ajusta 'token' si tu API usa otro nombre, ej: jsonData.accessToken)\r",
                  "var tokenRecibido = jsonData.accessToken;\r",
                  "\r",
                  "// 3. Guardar el token en la variable de entorno activa\r",
                  "pm.environment.set(\"jwtToken\", tokenRecibido);\r",
                  "\r",
                  "console.log(\"Token guardado exitosamente: \" + tokenRecibido);"
